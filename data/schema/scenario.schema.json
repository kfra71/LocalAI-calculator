{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bindwidth saved scenario v2",
  "type": "object",
  "required": ["schemaVersion", "state"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2 },
    "state": {
      "type": "object",
      "required": [
        "org", "staff", "mgmt", "econ", "workload", "agents", "rental",
        "subs", "resale", "resilience", "requirements", "media", "costs",
        "model", "hardware"
      ],
      "properties": {
        "model": { "type": "object", "required": ["id", "totalB", "activeB", "maxContext"] },
        "hardware": { "type": "array", "minItems": 1 },
        "resilience": {
          "type": "object",
          "required": ["targetUtilization", "nPlusOne"],
          "properties": {
            "targetUtilization": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "nPlusOne": { "type": "boolean" }
          }
        }
      }
    }
  }
}
